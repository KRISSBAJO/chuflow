PORT=4000
# For a separate organization, use a dedicated database, ID, name, and signing key.
# WORKSPACE_ID=another-church
# WORKSPACE_NAME=Another Church
MONGODB_URI=mongodb://127.0.0.1:27017/church_mgt
JWT_SECRET=change-this-super-secret-key
JWT_EXPIRES_IN=1d
WEB_URL=http://localhost:3001
CORS_ALLOWED_ORIGINS=http://localhost:3001
AUTH_COOKIE_NAME=cms_access_token
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
ADMIN_EMAIL=admin@church.local
ADMIN_PASSWORD=ChangeMe123!
# Control plane (optional). Workers read their plan from CONTROL_DATABASE_NAME; the primary API
# with PLATFORM_ENABLED=true hosts the operator API at /api/platform. Generate the key with
# `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`.
# CONTROL_DATABASE_NAME=chuflow_control
# CONTROL_ENCRYPTION_KEY=
# PLATFORM_ENABLED=false
# PLATFORM_JWT_SECRET=
# PLATFORM_OWNER_EMAIL=
# PLATFORM_OWNER_PASSWORD=
APP_NAME=ChuFlow
# Local SMTP by default. Production: MAIL_PROVIDER=relykit, set RELYKIT_API_KEY,
# and use a sender on your verified domain. Never expose the key to the web app.
MAIL_PROVIDER=smtp
RELYKIT_API_KEY=
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=no-reply@church.local

# Web push notifications for the installable app. Generate a pair with:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

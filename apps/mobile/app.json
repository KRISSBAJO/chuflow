{
  "expo": {
    "name": "ChuFlow",
    "slug": "chuflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "chuflow",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.chuflow.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "ChuFlow uses Face ID to unlock the app when App lock is on."
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.chuflow.app",
      "adaptiveIcon": {
        "backgroundColor": "#111111",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 88
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#ea580c"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "ChuFlow uses Face ID to unlock the app when App lock is on."
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "905f34db-2b85-4fa2-93e5-1d82900cebde"
      }
    },
    "owner": "logaxp"
  }
}
